{
  "cleanupPeriodDays": 99999,
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "/home/hatim/.nix-profile/share/ai/plugins/claude"
  },
  "permissions": {
    "allow": [
      "mcp__acp__Bash",
      "mcp__codegraph__*"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/nix/store/g5fckna5pxk85v103kgk08y4jdfpany8-git-ai-1.7.5/bin/git-ai checkpoint claude --hook-input stdin"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude-code-docs/claude-docs-helper.sh hook-check"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/nix/store/g5fckna5pxk85v103kgk08y4jdfpany8-git-ai-1.7.5/bin/git-ai checkpoint claude --hook-input stdin"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/hatim/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai memory prompt-hook",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "cloudflare@cloudflare": false,
    "cowork-plugin-management@synced": false,
    "figma@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "nx@nx-claude-plugins": false,
    "pyright-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "svelte@svelte": false,
    "superpowers@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "svelte": {
      "source": {
        "source": "github",
        "repo": "sveltejs/ai-tools"
      }
    },
    "voltagent-subagents": {
      "source": {
        "source": "github",
        "repo": "VoltAgent/awesome-claude-code-subagents"
      }
    }
  },
  "feedbackDrafts": "off",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "light",
  "editorMode": "vim",
  "verbose": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
